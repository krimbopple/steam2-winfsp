{
  "version": 6,
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "S2FS_BUILD_GUI": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "inherits": "common",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build-vs2022"
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "inherits": "common",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build-vs2026"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x64",
      "configuration": "MinSizeRel"
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x64",
      "configuration": "MinSizeRel"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x64",
      "configuration": "MinSizeRel",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x64",
      "configuration": "MinSizeRel",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
